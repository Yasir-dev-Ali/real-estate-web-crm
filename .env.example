# Copy this file to .env and replace JWT_SECRET with a fresh random secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COMPOSE_PROFILES=local
MONGO_URI=mongodb://mongo:27017/aurelia

# Local Docker SMTP inbox; do not use Mailpit for production email.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Aurelia Realty <no-reply@aurelia.local>

# Local HTTP access only. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:8080
WEB_PORT=8080
API_PORT=5001
MAILPIT_PORT=8025
SEED_DEMO_DATA=false
